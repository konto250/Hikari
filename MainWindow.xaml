<Window x:Class="Hikari.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="光採り  |  ハイライト除算" Width="1180" Height="800" MinWidth="820" MinHeight="640" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="14" Foreground="#1D3038" Background="#F4F5F2" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#23383A"/>
            <Setter Property="BorderBrush" Value="#C7D1CC"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Shell" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.80"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption"><Setter Property="Foreground" Value="#526463"/><Setter Property="FontSize" Value="13"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D7DFD8" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <Button x:Name="OpenButton" Content="画像を開く…" DockPanel.Dock="Right" Click="OpenClick"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#17695F">
                        <Path Stroke="White" StrokeThickness="2" Data="M 6,17 Q 17,3 28,17 Q 17,31 6,17 Z M 20,17 A 3,3 0 1 1 14,17 A 3,3 0 1 1 20,17"/>
                    </Border>
                    <TextBlock Text="光採り" FontWeight="Bold" FontSize="22" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ハイライト除算" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,7" BorderThickness="0,1,0,0" BorderBrush="#D7DFD8">
            <TextBlock x:Name="Status" Text="画像を開くか、ウィンドウにドロップしてください。" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <DockPanel Background="#202C32">
                <DockPanel DockPanel.Dock="Top" Margin="18,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="OriginalButton" Content="元画像" Click="OriginalClick"/>
                        <Button x:Name="ResultButton" Margin="6,0,0,0" Content="除算結果" Click="ResultClick"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="ZoomLabel" Foreground="#DBE6E1" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="全体表示を100%とした倍率"/>
                        <Button x:Name="FitButton" Content="全体表示" Click="FitClick"/>
                    </StackPanel>
                </DockPanel>
                <Grid x:Name="Stage" ClipToBounds="True" Background="#172127" SizeChanged="StageChanged" MouseWheel="ZoomWheel" MouseLeftButtonDown="StartDrag" MouseMove="MoveDrag" MouseLeftButtonUp="EndDrag" LostMouseCapture="DragCaptureLost">
                    <Canvas>
                        <Image x:Name="Preview" Stretch="Fill"/>
                        <Ellipse x:Name="Mark" IsHitTestVisible="False" Width="22" Height="22" Stroke="White" StrokeThickness="2" Visibility="Collapsed">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="1"/></Ellipse.Effect>
                        </Ellipse>
                        <Rectangle x:Name="Region" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#92FFE2" StrokeThickness="2" Fill="#2292FFE2"/>
                    </Canvas>
                    <TextBlock x:Name="EmptyHint" Text="ここに画像をドロップ" FontSize="20" Foreground="#B7CDC6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,22">
                    <TextBlock Text="ハイライト" FontSize="21" FontWeight="Bold"/>
                    <TextBlock x:Name="DetectLabel" Text="画像を開くと自動で検出します。" Style="{StaticResource Caption}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                    <Border Height="114" CornerRadius="6" Background="#233139" ClipToBounds="True">
                        <Grid><Image x:Name="Detail" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Ellipse x:Name="DetailMark" Visibility="Collapsed" Width="12" Height="12" Stroke="White" StrokeThickness="1.5">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Color="Black" Opacity="1"/></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Coordinates" Text="採色位置  —" Margin="0,7,0,12" Style="{StaticResource Caption}"/>
                    <Button x:Name="RegionButton" Content="目の範囲を指定…" Click="RegionClick"/>
                    <Border Height="1" Background="#D0DBD4" Margin="0,20"/>
                    <TextBlock Text="除算に使う色" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                        <Border x:Name="Swatch" Width="38" Height="38" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="#BECBC5" Margin="0,0,10,0"/>
                        <StackPanel><TextBlock x:Name="ColorText" Text="—" FontFamily="Consolas" FontSize="16"/>
                            <TextBlock x:Name="AdjustmentText" Text="調整量  0%" Style="{StaticResource Caption}"/></StackPanel>
                    </StackPanel>
                    <UniformGrid Columns="2"><Button x:Name="DarkerButton" Content="−  暗く" Margin="0,0,3,0" Click="DarkerClick"/>
                        <Button x:Name="LighterButton" Content="＋  明るく" Margin="3,0,0,0" Click="LighterClick"/></UniformGrid>
                    <Button x:Name="RestoreButton" Content="検出色に戻す" Margin="0,9,0,0" Click="RestoreClick"/>
                    <Border Height="1" Background="#D0DBD4" Margin="0,20"/>
                    <TextBlock x:Name="Dimensions" Text="出力サイズ  —" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                    <Button x:Name="OverwriteButton" Content="元画像に上書き保存" Background="#17695F" Foreground="White" BorderBrush="#17695F" FontWeight="SemiBold" Click="OverwriteClick"/>
                    <Button x:Name="SaveButton" Content="PNG に名前を付けて保存…" Margin="0,7,0,0" Click="SaveClick"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
